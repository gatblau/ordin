# ordin-minutes, Minutes Service: turns a meeting into minutes
error-min-body-invalid = The minutes are empty or too long to save.
error-min-edit-conflict = These minutes changed since you opened them. Reopen them to see the latest.
error-min-job-finished = That meeting has already finished.
error-min-job-not-found = That meeting is no longer being worked on.
error-min-job-not-ready = That recording is not text yet.
error-min-not-found = Those minutes are no longer here.
error-min-recording-in-progress = Ordin is already recording. Stop that recording first.
error-min-recording-not-found = That recording is no longer here.
error-min-setting-invalid = That setting can't be used.
error-min-store-failed = Ordin couldn't save the meeting on this computer. Free some space and try again.
error-min-transcript-too-long = That meeting is too long for one set of minutes.
error-min-workspace-unknown = That workspace is no longer here.
error-min-write-failed = Ordin couldn't write the minutes. Try again.
