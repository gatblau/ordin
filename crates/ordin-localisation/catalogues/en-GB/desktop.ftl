# Words of the desktop program itself (OrdinDesktop.md DSK-REC-4, DSK-REC-5).
desktop-backend-name = This computer
# The macOS application menu's Quit, built by the program so that it asks first (OrdinDesktop.md
# DSK-REC-35); `$product` is the brand's product name.
desktop-menu-quit = Quit { $product }
# The computer's notifications (OrdinDesktop.md step 7, DSK-NTF-1; amended January 2026; user decision;
# Approved by the user January 2026). `$coordinator` is the brand's name for Ordin; `$server` a connected
# server's name.
notification-approval-title = { $coordinator }: { $question }
notification-approval-body = Waiting for you
notification-run-done-title-unnamed = A task finished
notification-crew-done-title = Crew finished
notification-done-body = Done
notification-question-title = { $coordinator } has a question
notification-on-server = { $text } · On { $server }
# OrdinDesktop.md DSK-REC-51: under a conversation found by search.
goto-conversation-detail = Started { $date } · { $count } messages
