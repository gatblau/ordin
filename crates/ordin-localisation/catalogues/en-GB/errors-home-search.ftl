# Home and search error sentences.
error-home-datastore-unavailable = ordin can't reach your saved items right now. Try again in a moment.
error-home-mark-duplicate = That is already marked.
error-home-path-invalid = That place isn't valid. Choose it again.
error-home-query-invalid = Type between 1 and 200 characters to search.
error-home-run-not-found = That piece of work wasn't found, so it can't be run again.
error-home-source-unavailable = Part of this view couldn't be loaded. Try again in a moment.
error-home-workspace-not-found = That workspace wasn't found. Choose another.
