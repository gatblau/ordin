{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ordin",
  "identifier": "org.ordin.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "../../docs/logo/icons/light/tauri/32x32.png",
      "../../docs/logo/icons/light/tauri/128x128.png",
      "../../docs/logo/icons/light/tauri/128x128@2x.png",
      "../../docs/logo/icons/light/tauri/icon.icns",
      "../../docs/logo/icons/light/tauri/icon.ico"
    ],
    "externalBin": [
      "binaries/ordin-hook"
    ],
    "macOS": {
      "minimumSystemVersion": "13.7.1"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
