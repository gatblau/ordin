{
  "$defs": {
    "Minutes": {
      "additionalProperties": false,
      "description": "One meeting's minutes.",
      "properties": {
        "body": {
          "description": "Markdown, 1 byte to 1 MiB.",
          "type": "string"
        },
        "edited_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kept_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "recording": {
          "description": "`None` once the recording is deleted, and for imported files.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "At least 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/MinutesSource"
        },
        "source_name": {
          "description": "The file's name only, 1–255 characters.",
          "type": "string"
        },
        "title": {
          "description": "1–120 characters, no control character.",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "title",
        "source",
        "source_name",
        "body",
        "revision",
        "kept_at"
      ],
      "type": "object"
    },
    "MinutesExportInput": {
      "additionalProperties": false,
      "description": "`minutes.export`: the program reads the minutes itself; no content or path crosses.",
      "properties": {
        "format": {
          "$ref": "#/$defs/KnowledgeExportFormat"
        },
        "minutes_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "minutes_id",
        "format"
      ],
      "type": "object"
    },
    "MinutesIdInput": {
      "additionalProperties": false,
      "description": "`minutes.get`, `minutes.transcript`, `minutes.remove`, `minutes.delete_recording`.",
      "properties": {
        "minutes_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "minutes_id"
      ],
      "type": "object"
    },
    "MinutesJob": {
      "description": "One meeting being turned into minutes.",
      "properties": {
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/MinutesJobPurpose",
          "default": "minutes",
          "description": "Minutes, or text for Ordin; absent in JSON reads as minutes (WIRE-MIN-7)."
        },
        "source": {
          "$ref": "#/$defs/MinutesSource"
        },
        "source_name": {
          "description": "The file's name only.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/MinutesJobState"
        },
        "workspace_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "source_name",
        "source",
        "state",
        "created_at"
      ],
      "type": "object"
    },
    "MinutesJobInput": {
      "additionalProperties": false,
      "description": "`minutes.cancel_job`, `minutes.retry`.",
      "properties": {
        "job_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "type": "object"
    },
    "MinutesJobPurpose": {
      "description": "What a job makes: minutes, or a recording turned into text for Ordin.",
      "enum": [
        "minutes",
        "transcript"
      ],
      "type": "string"
    },
    "MinutesJobState": {
      "description": "Where a job is.",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "queued",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "waiting_for_model",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "received_mb": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "downloading_model",
              "type": "string"
            },
            "total_mb": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "state",
            "received_mb",
            "total_mb"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "reading",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "done_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "transcribing",
              "type": "string"
            },
            "total_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "state",
            "done_ms",
            "total_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "waiting_for_notice",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "writing",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "minutes_id": {
              "format": "uuid",
              "type": "string"
            },
            "state": {
              "const": "done",
              "type": "string"
            }
          },
          "required": [
            "state",
            "minutes_id"
          ],
          "type": "object"
        },
        {
          "description": "A job of purpose `transcript`: the text is ready for Ordin (WIRE-MIN-7).",
          "properties": {
            "state": {
              "const": "transcript_ready",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "MinutesListInput": {
      "additionalProperties": false,
      "description": "`minutes.list`: 50 per page, newest first.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "type": "object"
    },
    "MinutesSaveEditInput": {
      "additionalProperties": false,
      "description": "`minutes.save_edit`: body 1 byte to 1 MiB, `base_revision` at least 1.",
      "properties": {
        "base_revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "body": {
          "type": "string"
        },
        "minutes_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "minutes_id",
        "body",
        "base_revision"
      ],
      "type": "object"
    },
    "MinutesSettings": {
      "description": "The settings the person changes.",
      "properties": {
        "delete_recordings_after_save": {
          "type": "boolean"
        },
        "obs_port": {
          "description": "1024–65535.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "speech_model": {
          "$ref": "#/$defs/SpeechModelSetting"
        }
      },
      "required": [
        "speech_model",
        "delete_recordings_after_save",
        "obs_port"
      ],
      "type": "object"
    },
    "MinutesSettingsChange": {
      "additionalProperties": false,
      "description": "Each field optional; at least one.",
      "properties": {
        "delete_recordings_after_save": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "obs_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "speech_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechModelSetting"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "MinutesSource": {
      "description": "Where the minutes came from.",
      "enum": [
        "transcript_file",
        "audio_file",
        "recording"
      ],
      "type": "string"
    },
    "MinutesStatus": {
      "description": "What the Minutes screens show.",
      "properties": {
        "model": {
          "$ref": "#/$defs/SpeechModelInfo",
          "description": "The model in use: the recommendation for `recommended`, else the chosen one."
        },
        "model_consent_given": {
          "type": "boolean"
        },
        "recommended_model": {
          "$ref": "#/$defs/SpeechModelChoice",
          "description": "What this computer handles well (TRX-MACH-3)."
        },
        "recorder": {
          "$ref": "#/$defs/ObsState"
        },
        "recording": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingView"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "$ref": "#/$defs/MinutesSettings"
        },
        "writer_name": {
          "description": "The AI service named in the notice.",
          "type": "string"
        },
        "writer_notice_seen": {
          "type": "boolean"
        }
      },
      "required": [
        "settings",
        "model",
        "recommended_model",
        "model_consent_given",
        "writer_notice_seen",
        "writer_name",
        "recorder"
      ],
      "type": "object"
    },
    "MinutesStopInput": {
      "additionalProperties": false,
      "description": "`minutes.stop`.",
      "properties": {
        "recording_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "recording_id"
      ],
      "type": "object"
    },
    "MinutesSummary": {
      "additionalProperties": false,
      "description": "One line of the Minutes list.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kept_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "source": {
          "$ref": "#/$defs/MinutesSource"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "source",
        "kept_at"
      ],
      "type": "object"
    },
    "MinutesWorkspaceInput": {
      "additionalProperties": false,
      "description": "`minutes.status`, `minutes.import`, `minutes.jobs`, `minutes.record`.",
      "properties": {
        "workspace_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "type": "object"
    },
    "ObsPasswordInput": {
      "additionalProperties": false,
      "description": "`minutes.save_obs_password`: 1–256 characters. Never logged, journalled or echoed; `Debug` hides it.",
      "properties": {
        "password": {
          "type": "string"
        }
      },
      "required": [
        "password"
      ],
      "type": "object"
    },
    "ObsState": {
      "description": "What OBS can do for Ordin now.",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "not_installed",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "Installed, but nothing answers on the port (OBS closed, or its WebSocket server off).",
          "properties": {
            "state": {
              "const": "not_reachable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The server asks for a password and none is stored.",
          "properties": {
            "state": {
              "const": "password_needed",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The stored password was refused.",
          "properties": {
            "state": {
              "const": "password_refused",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "OBS older than 28 or a WebSocket RPC version other than 1.",
          "properties": {
            "obs_version": {
              "type": "string"
            },
            "state": {
              "const": "version_unsupported",
              "type": "string"
            }
          },
          "required": [
            "state",
            "obs_version"
          ],
          "type": "object"
        },
        {
          "properties": {
            "obs_version": {
              "type": "string"
            },
            "others_heard": {
              "type": "boolean"
            },
            "state": {
              "const": "ready",
              "type": "string"
            }
          },
          "required": [
            "state",
            "obs_version",
            "others_heard"
          ],
          "type": "object"
        },
        {
          "properties": {
            "others_heard": {
              "type": "boolean"
            },
            "started_at": {
              "$ref": "#/$defs/Timestamp"
            },
            "state": {
              "const": "recording",
              "type": "string"
            }
          },
          "required": [
            "state",
            "started_at",
            "others_heard"
          ],
          "type": "object"
        }
      ]
    },
    "Page_MinutesSummary": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/MinutesSummary"
          },
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Always serialised; `null` on the last page (the one `Option` not skipped when `None`)."
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "RecordingView": {
      "description": "The running recording.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "others_heard": {
          "type": "boolean"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspace_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "started_at",
        "others_heard"
      ],
      "type": "object"
    },
    "SpeechModelChoice": {
      "description": "Which speech model: the larger (more accurate, about 1.5 GB) or the smaller (faster, about\n470 MB). There is no fixed default: the machine recommends one (TRX-MACH-1).",
      "enum": [
        "larger",
        "smaller"
      ],
      "type": "string"
    },
    "SpeechModelInfo": {
      "description": "One speech model as the consent prompt shows it.",
      "properties": {
        "choice": {
          "$ref": "#/$defs/SpeechModelChoice"
        },
        "file_name": {
          "description": "From `speech-models.json`, e.g. \"ggml-medium.bin\".",
          "type": "string"
        },
        "folder": {
          "description": "The models folder, shown in the consent prompt; the one path that crosses the boundary.",
          "type": "string"
        },
        "present": {
          "description": "The file exists; it is written only after its checksum matched.",
          "type": "boolean"
        },
        "size_mb": {
          "description": "Shown in the consent prompt.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "choice",
        "file_name",
        "size_mb",
        "folder",
        "present"
      ],
      "type": "object"
    },
    "SpeechModelSetting": {
      "description": "The person's speech model setting: the machine's recommendation, or their own choice, which\nwins over it.",
      "enum": [
        "recommended",
        "larger",
        "smaller"
      ],
      "type": "string"
    },
    "Transcript": {
      "description": "A meeting as timed utterances.",
      "properties": {
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "format": {
          "description": "Always 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "description": "BCP 47 tag detected by the model; `None` for transcript files.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "$ref": "#/$defs/TranscriptSourceKind"
        },
        "source_name": {
          "description": "The file name only, 1–255 characters.",
          "type": "string"
        },
        "utterances": {
          "description": "Ordered by `start_ms`, then speaker; at least one.",
          "items": {
            "$ref": "#/$defs/Utterance"
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "source_kind",
        "source_name",
        "duration_ms",
        "utterances"
      ],
      "type": "object"
    },
    "TranscriptSourceKind": {
      "description": "Where a transcript came from.",
      "enum": [
        "transcript_file",
        "audio_file",
        "recording"
      ],
      "type": "string"
    },
    "Utterance": {
      "description": "One timed piece of speech.",
      "properties": {
        "end_ms": {
          "description": "At least `start_ms`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "speaker": {
          "description": "1–80 characters; `None` when the source names no speaker.",
          "type": [
            "string",
            "null"
          ]
        },
        "start_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "1–4,000 characters, trimmed, single spaces.",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-ordin-commands": [
    {
      "effect": "read",
      "input": {
        "$ref": "#/$defs/MinutesWorkspaceInput"
      },
      "ipc_name": "minutes_status",
      "name": "minutes.status",
      "rest_path": "/v1/minutes/status",
      "result": {
        "$ref": "#/$defs/MinutesStatus"
      },
      "scope": "local"
    },
    {
      "effect": "read",
      "input": {
        "$ref": "#/$defs/MinutesListInput"
      },
      "ipc_name": "minutes_list",
      "name": "minutes.list",
      "rest_path": "/v1/minutes/list",
      "result": {
        "$ref": "#/$defs/Page_MinutesSummary"
      },
      "scope": "local"
    },
    {
      "effect": "read",
      "input": {
        "$ref": "#/$defs/MinutesIdInput"
      },
      "ipc_name": "minutes_get",
      "name": "minutes.get",
      "rest_path": "/v1/minutes/get",
      "result": {
        "$ref": "#/$defs/Minutes"
      },
      "scope": "local"
    },
    {
      "effect": "read",
      "input": {
        "$ref": "#/$defs/MinutesIdInput"
      },
      "ipc_name": "minutes_transcript",
      "name": "minutes.transcript",
      "rest_path": "/v1/minutes/transcript",
      "result": {
        "$ref": "#/$defs/Transcript"
      },
      "scope": "local"
    },
    {
      "effect": "change",
      "input": {
        "$ref": "#/$defs/MinutesSaveEditInput"
      },
      "ipc_name": "minutes_save_edit",
      "name": "minutes.save_edit",
      "rest_path": "/v1/minutes/save_edit",
      "result": {
        "$ref": "#/$defs/Minutes"
      },
      "scope": "local"
    },
    {
      "effect": "change",
      "input": {
        "$ref": "#/$defs/MinutesIdInput"
      },
      "ipc_name": "minutes_remove",
      "name": "minutes.remove",
      "rest_path": "/v1/minutes/remove",
      "result": {
        "$ref": "#/$defs/Done"
      },
      "scope": "local"
    },
    {
      "effect": "change",
      "input": {
        "$ref": "#/$defs/MinutesWorkspaceInput"
      },
      "ipc_name": "minutes_import",
      "name": "minutes.import",
      "rest_path": "/v1/minutes/import",
      "result": {
        "$ref": "#/$defs/MinutesJob"
      },
      "scope": "local"
    },
    {
      "effect": "read",
      "input": {
        "$ref": "#/$defs/MinutesWorkspaceInput"
      },
      "ipc_name": "minutes_jobs",
      "name": "minutes.jobs",
      "rest_path": "/v1/minutes/jobs",
      "result": {
        "items": {
          "$ref": "#/$defs/MinutesJob"
        },
        "type": "array"
      },
      "scope": "local"
    },
    {
      "effect": "change",
      "input": {
        "$ref": "#/$defs/MinutesJobInput"
      },
      "ipc_name": "minutes_cancel_job",
      "name": "minutes.cancel_job",
      "rest_path": "/v1/minutes/cancel_job",
      "result": {
        "$ref": "#/$defs/MinutesJob"
      },
      "scope": "local"
    },
    {
      "effect": "change",
      "input": {
        "$ref": "#/$defs/MinutesJobInput"
      },
      "ipc_name": "minutes_retry",
      "name": "minutes.retry",
      "rest_path": "/v1/minutes/retry",
      "result": {
        "$ref": "#/$defs/MinutesJob"
      },
      "scope": "local"
    },
    {
      "effect": "change",
      "input": {
        "$ref": "#/$defs/Done"
